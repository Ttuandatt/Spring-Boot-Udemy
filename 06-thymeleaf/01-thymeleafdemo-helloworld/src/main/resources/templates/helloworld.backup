<!DOCTYPE HTML>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Thymeleaf Demo</title>
    <link rel="stylesheet" th:href="@{/css/demo.css}">
</head>

<body>
    <h1>Hello World</h1>
    <p th:text="'Time on the server is: ' + ${theDate}" class="funny"></p>  <!--theDate is in DemoController-->
</body>

